APP_ENV=development
APP_PORT=8080

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=derick
POSTGRES_PASSWORD=derick
POSTGRES_DB=bangunin_aja
POSTGRES_SSLMODE=disable
POSTGRES_TIMEZONE=Asia/Jakarta

# Zona waktu backend untuk "hari ini": jatuh tempo, riwayat progres, laporan.
APP_TIMEZONE=Asia/Jakarta

JWT_ACCESS_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=bangunin-aja

REFRESH_COOKIE_NAME=bangunin_refresh_token
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SAMESITE=lax
COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Internal scoring service (Moses's Python /score, contract §8).
# Run scoring/ (see scoring/README.md) and set http://host.docker.internal:8090.
# Leave SCORE_SERVICE_URL empty to use the built-in deterministic stub so
# /api/site/evaluate works before the real service is live.
SCORE_SERVICE_URL=
SCORE_SERVICE_TIMEOUT=15s

# On-chain payment simulation on the Ethereum Sepolia testnet (N3). The company
# only receives: put a wallet address you control here (never a private key).
# Leave ONCHAIN_RECEIVER_ADDRESS empty to switch the feature off; /tagihan then
# hides "Bayar on-chain". ONCHAIN_IDR_PER_ETH is a simulation rate, not a
# market price: 1e12 means Rp 1 triliun = 1 SepoliaETH, so Rp 50 juta is
# 0.00005 SepoliaETH (affordable from a faucet).
ONCHAIN_RECEIVER_ADDRESS=
ONCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ONCHAIN_CHAIN_ID=11155111
ONCHAIN_IDR_PER_ETH=1e12
ONCHAIN_MIN_CONFIRMATIONS=1
ONCHAIN_REQUEST_TTL=30m
ONCHAIN_EXPLORER_URL=https://sepolia.etherscan.io

# QRIS through a payment gateway. Leave everything empty to switch it off.
# PAYMENT_GATEWAY=fake runs a built-in simulator (no account, no real money)
# so the whole flow can be demoed offline. For Xendit, create a Test Mode
# secret key (starts with xnd_development_, Money-In write permission) and copy
# the webhook verification token from Settings > Webhooks; the webhook URL is
# https://<public host>/api/pay/xendit/webhook. A development key also enables
# the "simulasikan pembayaran" button; a production key never does.
PAYMENT_GATEWAY=
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_API_URL=https://api.xendit.co
GATEWAY_REQUEST_TTL=30m
